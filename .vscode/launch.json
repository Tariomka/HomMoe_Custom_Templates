{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch GUI",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/main.go",
        },
        {
            "name": "Run Performance Profiling",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${file}",
            // "program": "${workspaceFolder}/test/performance/window_tab_cycling_test.go",
            "args": [
                "-bench BenchmarkEditorWindow_TabCycling",
                "-cpuprofile cpu.prof",
                "-memprofile memory.prof",
                "-benchtime 1x",
                "-timeout 120s",
                "-args headed"
            ]
        }
    ]
}