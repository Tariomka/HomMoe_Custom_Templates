    // NOTE: The "integration_test" build tag is intentionally NOT set as a
    // global go.testTags/go.buildTags, so a normal test run does NOT compile
    // with it. Only gopls uses it below (analysis only) so the tagged
    // integration/performance test files still get IntelliSense. Actually
    // RUNNING those tagged tests is done via the dedicated task in
    // .vscode/tasks.json, which scopes -tags=integration_test to
    // ./test/integration and ./test/performance only.
    "gopls": {
        "build.buildFlags": ["-tags=integration_test"],
        "ui.semanticTokens": true,
        "ui.diagnostic.staticcheck": true,
        "ui.diagnostic.analyses": {
            "ST1006": false, // Too noisy. Generic name is useful to distinguish attached struct from ouside variables. Single character names are evil
            "ST1003": false, // Too many package overpals, need more descriptive package names

            "ST1000": false, // Temporarily disabled while still work in progress
        }
    },
}