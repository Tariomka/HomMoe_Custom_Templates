    "cSpell.words": [
        "Alvars",
        "andygrunwald",
        "Bannable",
        "brianvoe",
        "Chimerologist",
        "circumcircle",
        "Clickables",
        "docstrings",
        "dtos",
        "gioui",
        "gofakeit",
        "gofmt",
        "gofont",
        "heros",
        "hommoe",
        "Huntsmans",
        "Insaras",
        "Interactable",
        "Interactables",
        "isolateplayers",
