{
    "cSpell.words": [
        "Alvars",
        "andygrunwald",
        "Bannable",
        "brianvoe",
        "Chebyshev",
        "Chimerologist",
        "circumcircle",
        "Clickables",
        "cyclop",
        "depguard",
        "docstrings",
        "dtos",
        "gioui",
        "gofakeit",
        "gofmt",
        "gofont",
        "golines",
        "govet",
        "heros",
        "hommoe",
        "Huntsmans",
        "Insaras",
        "Interactable",
        "Interactables",
        "isolateplayers",
        "linq",
        "Mereas",
        "movepoints",
        "nolint",
        "nring",
        "Quixs",
        "Regen",
        "stretchr",
        "syscalls",
        "Tariomka",
        "texel",
        "Themeless",
        "Truncator",
        "uncommons"
    ],
    "gopls": {
        "build.buildFlags": ["-tags=integration_test"],
        "ui.semanticTokens": true,
        "ui.diagnostic.staticcheck": true,
        "ui.diagnostic.analyses": {
            "ST1000": false, // Temporary
            "ST1003": false, // disabled by choice, see .golangci.yml for more details
            "ST1006": false, // disabled by choice, see .golangci.yml for more details
            "unusedwrite": false, // golangci-lint already handles this at error level
        }
    },
    "go.lintTool": "golangci-lint-v2",
    "go.lintFlags": [
        "--path-mode=abs",
        "--fast-only",
        "--fix",
    ],
    "go.formatTool": "custom",
    "go.alternateTools": { "customFormatter": "golangci-lint-v2" },
    "go.formatFlags": ["fmt", "--stdin"],
    "go.testFlags": [ "-count=1", "-v", ],
    "go.inlayHints.assignVariableTypes": false,
    "go.inlayHints.constantValues": false,
    "go.inlayHints.ignoredError": true,
    "go.inlayHints.rangeVariableTypes": false,
    "go.testExplorer.packageDisplayMode": "nested",
    "go.lintOnSave": "file",
    "coverage-gutters.coverageFileNames": [
        "lcov.info",
        "cov.xml",
        "coverage.xml",
        "cobertura.xml",
        "jacoco.xml",
        "coverage.cobertura.xml"
    ],
    "coverage-gutters.showLineCoverage": false, // Still not sure about this one to be honest
    "coverage-gutters.showGutterCoverage": true,
}