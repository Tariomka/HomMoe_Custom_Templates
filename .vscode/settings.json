{
    "cSpell.words": [
        "Alvars",
        "andygrunwald",
        "Bannable",
        "brianvoe",
        "Chebyshev",
        "Chimerologist",
        "circumcircle",
        "Clickables",
        "docstrings",
        "dtos",
        "gioui",
        "gofakeit",
        "gofmt",
        "gofont",
        "heros",
        "hommoe",
        "Huntsmans",
        "Insaras",
        "Interactable",
        "Interactables",
        "isolateplayers",
        "linq",
        "Mereas",
        "movepoints",
        "nring",
        "Quixs",
        "Regen",
        "stretchr",
        "syscalls",
        "Tariomka",
        "texel",
        "Themeless",
        "Truncator",
        "uncommons"
    ],
    "gopls": {
        "build.buildFlags": ["-tags=integration_test"],
        "ui.semanticTokens": true,
    },
    "go.lintTool": "golangci-lint-v2",
    "go.lintFlags": [
        "--path-mode=abs",
        "--fast-only",
        "--fix",
    ],
    "go.formatTool": "custom",
    "go.alternateTools": {
        "customFormatter": "golangci-lint-v2"
    },
    "go.formatFlags": ["fmt", "--stdin"],
    // Coverage: use Test Explorer "Run with coverage" for gutter highlights.
    // -coverpkg is required because tests live in test/ while code lives in internal/ and app/.
    // (coverOnSave can't work here: source packages contain no tests.)
    "go.testFlags": [
        "-count=1",
        "-v",
        "-coverpkg=github.com/Tariomka/hommoe_custom_templates/internal/...,github.com/Tariomka/hommoe_custom_templates/app/..."
    ],
    "go.inlayHints.assignVariableTypes": false,
    "go.inlayHints.constantValues": false,
    "go.inlayHints.ignoredError": true,
    "go.inlayHints.rangeVariableTypes": false,
    "go.testExplorer.packageDisplayMode": "nested",
    "go.lintOnSave": "file",
}