{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Go: Run Integration tests w/out UI",
            "type": "shell",
            "command": "go",
            "args": [
                "test",
                "-tags=integration_test",
                "-count=1",
                "./test/integration/..."
            ],
            "group": "test",
            "problemMatcher": "$go"
        },
        {
            "label": "Go: Run UI Integration tests",
            "type": "shell",
            "command": "go",
            "args": [
                "test",
                "-tags=integration_test && gui",
                "-count=1",
                "./test/integration/gui/...",
            ],
            "group": "test",
            "problemMatcher": "$go"
        },
        {
            "label": "Go: Run UI Integration tests w/ headed mode",
            "type": "shell",
            "command": "go test '-tags=integration_test && gui' ./test/integration/gui/... -count 1 -args headed",
            "group": "test",
            "problemMatcher": "$go"
        },
        {
            "label": "Go: Update UI Integration tests snapshots",
            "type": "shell",
            "command": "go",
            "args": [
                "test",
                "-tags=integration_test && gui",
                "./test/integration/gui/...",
                "-count=1",
                "-update"
            ],
            "group": "test",
            "problemMatcher": "$go"
        },
        {
            "label": "Go: Run Performance tests",
            "type": "shell",
            "command": "go",
            "args": [
                "test",
                "-v",
                "-bench=BenchmarkEditorWindow_TabCycling",
                "-run=xxx",
                "./test/performance/...",
                "-tags=integration_test",
                "-benchmem",
                // "-cpuprofile='cpu.prof'",
                // "-memprofile='memory.prof'",
                "-benchtime=20x",
                "-timeout=120s",
                // "-args=headed"
            ],
            "group": "test",
            "problemMatcher": "$go"
        },
        {
            "label": "Go: Run Unit tests",
            "type": "shell",
            "command": "go",
            "args": [
                "test",
                "-count=1",
                "./test/unit/..."
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": "$go"
        },
        {
            "label": "Go: Generate code coverage report",
            "type": "shell",
            "command": "go test -count=1 '-coverpkg=./internal/...,./app/...' '-coverprofile=coverage.txt' ./test/unit/...; go tool cover '-html=coverage.txt' -o coverage.html; gcov2lcov '-infile=coverage.txt' '-outfile=lcov.info'",
            "group": "test",
            "problemMatcher": "$go"
        },
        {
            "label": "Go: Run Linter",
            "type": "shell",
            "command": "golangci-lint-v2",
            "args": [ "run", "./...", "--issues-exit-code=0", "--fix" ],
            "problemMatcher": {
                "owner": "go",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^([^\\s].*):(\\d+):(\\d+):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "message": 4
                }
            },
            "group": {
                "kind": "build",
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            }
        },
        {
            "label": "Go: Get Linter Results",
            "type": "shell",
            "command": "golangci-lint-v2",
            "args": [
                "run",
                "./...",
                "--issues-exit-code=0",
                // "--cpu-profile-path=${cwd}/tmp/lint-cpu.prof",
                // "--mem-profile-path=${cwd}/tmp/lint-mem.prof",
                // "--trace-path=${cwd}/tmp/lint-trace.out",
            ], 
            "problemMatcher": {
                "owner": "go",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^([^\\s].*):(\\d+):(\\d+):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "message": 4
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": true
            }
        }
    ]
}

